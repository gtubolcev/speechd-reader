{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "speechd-reader@tuboltsev.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "menus",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/speaker.svg"
  },
  "icons": {
    "48": "icons/speaker.svg",
    "96": "icons/speaker.svg"
  },
  "commands": {
    "read-article": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_cmdReadArticle__"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdPick__"
    },
    "pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_cmdPause__"
    },
    "stop": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "__MSG_cmdStop__"
    }
  },
  "default_locale": "en"
}
