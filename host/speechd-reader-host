"""Native messaging host of the speechd-reader browser extension.

Speaks text through Speech Dispatcher. Each message carries its language,
and Speech Dispatcher uses the user's configuration (DefaultModule,
LanguageDefaultModule, the module's voice for the language, DefaultRate, ...).
One exception: when the module the server gives for a language has no voice
for it (DefaultModule "vosk" and a German page), the host picks a module that
has one: a voice for the exact language first (de-AT), then for the base
language, espeak last. The host reads no configuration file: it asks the
server (GET OUTPUT_MODULE after SET LANGUAGE, LIST OUTPUT_MODULES, LIST
SYNTHESIS_VOICES) on a short connection of its own. What it picked goes to
~/.cache/speechd-reader/host.log (languages and modules only, never the text).

Protocol (native messaging: 32-bit native-endian length + UTF-8 JSON):
  in:  {"cmd": "speak", "id": N, "text": "...", "lang": "uk"}
       {"cmd": "speak", "id": N, "parts": ["...", "..."], "lang": "uk"}
           (one utterance with an index mark before each part: the
            sentences of a paragraph, so the module synthesizes the next
            while the last one plays)
       {"cmd": "stop"}
       {"cmd": "rate", "value": -100..100 or null}   (null: the user's default)
       {"cmd": "hello"}
  out: {"event": "begin"|"end"|"cancel", "id": N}
       {"event": "mark", "id": N, "part": K}   (part K begins to sound)
       {"event": "lost", "id": N}   (the server went away before N ended:
                                     speak it again, a new server answers)
       {"event": "hello", "version": "...", "rate": R}
       {"event": "error", "id": N or null, "message": "..."}
"""

import json
from xml.sax.saxutils import escape
import os
import re
import signal
import struct
import sys
import threading
import time

VERSION = "0.1"
MAX_MESSAGE = 1024 * 1024      # Firefox sends at most 4 GB; we take 1 MB
MAX_TEXT = 100_000             # characters in one utterance
MAX_PARTS = 200
LANG_RE = re.compile(r"^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{1,8})*$")

out_lock = threading.Lock()

# Speech Dispatcher gives a connection its defaults (module, rate, ...) when
# it opens; after the user changes them and the server reloads, only a new
# connection gets them. Before a new utterance the host asks the server what a
# new connection would get now, at most every CHECK_INTERVAL, and reconnects
# when that changed.
CHECK_INTERVAL = 2.0
SERVER_DEFAULTS = ("OUTPUT_MODULE", "LANGUAGE", "RATE", "PITCH", "VOLUME", "PUNCTUATION")
REPLY_TIMEOUT = 15.0    # a server that is alive answers a command at once
WATCH_INTERVAL = 0.5    # how often to look whether the connection still lives


def patch_speechd(speechd):
    """python3-speechd waits for a reply without a limit: when the server
    dies between its check and the wait (a crash on a reload), the caller
    hangs for ever. Wait in slices, and give up when the reader is gone."""
    conn_class = speechd.client._SSIP_Connection

    def _recv_response(self):
        deadline = time.monotonic() + REPLY_TIMEOUT
        while not self._ssip_reply_semaphore.acquire(timeout=0.2):
            if not self._communication_thread.is_alive() or time.monotonic() > deadline:
                raise speechd.SSIPCommunicationError("Speech Dispatcher does not answer")
        return self._com_buffer.pop(0)

    conn_class._recv_response = _recv_response


def connection_alive(client):
    conn = getattr(client, "_conn", None)
    thread = getattr(conn, "_communication_thread", None)
    return thread is None or thread.is_alive()


LOG_MAX = 256 * 1024
FALLBACK_LAST = ("espeak-ng", "espeak", "espeak-ng-mbrola", "dummy")


def log(line):
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(base, "speechd-reader", "host.log")
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        try:
            if os.stat(path).st_size > LOG_MAX:
                os.replace(path, path + ".1")
        except FileNotFoundError:
            pass
        with open(path, "a", encoding="utf-8") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + "\n")
    except OSError:
        pass


def get(client, what):
    """GET @what on @client (the server has GET for long; the getters of
    python3-speechd are newer)"""
    code, msg, data = client._conn.send_command("GET", what)
    return data[0] if data else None


def same_language(voice_lang, language):
    v = (voice_lang or "").lower().replace("_", "-")
    return v == language or v.split("-")[0] == language.split("-")[0]


def debug_enabled():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.exists(os.path.join(base, "speechd-reader", "debug"))


DEBUG = debug_enabled()


def debug(line):
    """Protocol trace for bug hunting, on while ~/.cache/speechd-reader/debug
    exists (read at start). Never the text: ids, events, lengths only."""
    if DEBUG:
        log("[%d] %s" % (threading.get_ident() % 10000, line))


def send(obj):
    debug("-> %s id=%s%s" % (obj.get("event"), obj.get("id"),
                             " msg=%r" % obj["message"] if obj.get("message") else ""))
    data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
    with out_lock:
        sys.stdout.buffer.write(struct.pack("=I", len(data)) + data)
        sys.stdout.buffer.flush()


def receive():
    """The next message, or None at the end of the input."""
    head = sys.stdin.buffer.read(4)
    if len(head) < 4:
        return None
    (length,) = struct.unpack("=I", head)
    if length > MAX_MESSAGE:
        raise ValueError("message too long")
    data = sys.stdin.buffer.read(length)
    if len(data) < length:
        return None
    msg = json.loads(data.decode("utf-8"))
    if DEBUG and isinstance(msg, dict):
        text = msg.get("text")
        debug("<- %s id=%s lang=%s len=%s value=%s" % (
            msg.get("cmd"), msg.get("id"), msg.get("lang"),
            len(text) if isinstance(text, str) else None, msg.get("value")))
    return msg


def speechd_language(tag):
    """'en-US' -> 'en', 'pt-BR' -> 'pt-br': the configs name plain languages,
    regions only where they make a different language for the synthesizers."""
    if not isinstance(tag, str) or not LANG_RE.match(tag):
        return None
    parts = tag.replace("_", "-").lower().split("-")
    if parts[0] in ("pt", "zh") and len(parts) > 1 and len(parts[1]) == 2:
        return parts[0] + "-" + parts[1]
    return parts[0]


# control characters of the page (XML 1.0 has no place for them; a module
# may refuse the whole message) become spaces
CONTROL = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f\x7f\ufffe\uffff]")


def ssml(parts):
    """the parts as SSML with the index mark "K" before part K"""
    return "<speak>" + " ".join('<mark name="%d"/>%s' % (i, escape(CONTROL.sub(" ", t)))
                                for i, t in enumerate(parts)) + "</speak>"


class Speaker:
    def __init__(self):
        import speechd
        try:
            import speechd.client
        except ImportError:
            pass
        self.speechd = speechd
        if hasattr(getattr(speechd, "client", None), "_SSIP_Connection"):
            patch_speechd(speechd)
        self.client = None
        self.lock = threading.Lock()
        self.rate = None
        self.defaults = None        # what a new connection got, see CHECK_INTERVAL
        self.checked = 0.0
        self.outstanding = set()    # ids spoken and not yet ended
        self.voices = {}            # module -> set of voice languages, per server defaults
        self.routes = {}            # language -> (chosen, configured) module
        threading.Thread(target=self.watch, daemon=True).start()

    def watch(self):
        """The server crashed or quit: tell which utterances were lost, so
        the extension speaks them again (a new server starts on demand)."""
        while True:
            time.sleep(WATCH_INTERVAL)
            with self.lock:
                if self.client is None or connection_alive(self.client):
                    continue
                lost = sorted(self.outstanding)
                debug("connection died; lost=%s" % lost)
                self.drop()
            for msg_id in lost:
                send({"event": "lost", "id": msg_id})

    def server_state(self):
        """(defaults a new connection gets, {routed language: its module}),
        asked on a short connection; None when the server does not answer."""
        def ask(c):
            defaults = tuple(get(c, w) for w in SERVER_DEFAULTS) \
                + tuple(c.list_output_modules())
            modules = {}
            for language in list(self.routes)[:20]:
                # SET LANGUAGE changes the module only where a
                # LanguageDefaultModule is set: start from the default
                if defaults[0]:
                    c.set_output_module(defaults[0])
                c.set_language(language)
                modules[language] = get(c, "OUTPUT_MODULE")
            return defaults, modules
        try:
            return self.call_probe(ask)
        except Exception as e:
            debug("server state: %s: %s" % (type(e).__name__, e))
            return None

    def settings_changed(self):
        """The user changed the server's settings since this connection
        opened (only a new connection gets them)."""
        now = time.monotonic()
        if now - self.checked < CHECK_INTERVAL:
            return False
        self.checked = now
        state = self.server_state()
        if state is None:
            return False
        defaults, modules = state
        if defaults != self.defaults:
            return True
        # LanguageDefaultModule: the server applies it on SET LANGUAGE, no
        # new connection needed; only the routes must be made again
        for language, module in modules.items():
            if language in self.routes and self.routes[language][1] != module:
                debug("%s now goes to %s" % (language, module))
                del self.routes[language]
        return False

    def connect(self):
        if self.client is not None and not self.outstanding and self.settings_changed():
            debug("server settings changed, reconnect")
            self.drop()
        if self.client is None:
            state = self.server_state()
            defaults = state[0] if state else None
            if defaults != self.defaults:
                self.routes, self.voices = {}, {}
            self.defaults = defaults
            self.checked = time.monotonic()
            self.client = self.speechd.SSIPClient("speechd-reader", "browser",
                                                  autospawn=True)
            debug("connected")
            # everything goes as SSML: the index marks of paragraphs
            self.client.set_data_mode(self.speechd.DataMode.SSML)
            if self.rate is not None:
                self.client.set_rate(self.rate)
        return self.client

    def drop(self):
        if self.client is not None:
            try:
                self.client.close()
            except Exception:
                pass
            self.client = None
        self.outstanding.clear()     # a closed connection sends no more events

    def call(self, fn):
        """fn(client), reconnecting once if the server went away."""
        with self.lock:
            try:
                return fn(self.connect())
            except (self.speechd.SSIPCommunicationError, OSError, BrokenPipeError) as e:
                lost = sorted(self.outstanding)
                debug("call failed (%s: %s), reconnect; lost=%s" % (type(e).__name__, e, lost))
                self.drop()
                for msg_id in lost:
                    send({"event": "lost", "id": msg_id})
                return fn(self.connect())

    def module_languages(self, module):
        """Voice languages of @module, asked on a connection of its own (the
        reading connection keeps its module)."""
        if module not in self.voices:
            langs = set()
            probe = self.speechd.SSIPClient("speechd-reader", "probe", autospawn=True)
            try:
                probe.set_output_module(module)
                for voice in probe.list_synthesis_voices():
                    if len(voice) > 1 and voice[1]:
                        langs.add(voice[1].lower().replace("_", "-"))
            finally:
                probe.close()
            self.voices[module] = langs
        return self.voices[module]

    def has_voice(self, module, language):
        try:
            return any(same_language(v, language) for v in self.module_languages(module))
        except Exception:
            return True     # can't tell: leave it to the configuration

    def route(self, language):
        """The module for @language: the one the server gives, or, when it
        has no voice for the language, one that has."""
        if language in self.routes:
            return self.routes[language]

        def ask(c):
            c.set_language(language)
            return get(c, "OUTPUT_MODULE"), list(c.list_output_modules())
        try:
            configured, modules = self.call_probe(ask)
        except Exception as e:
            debug("route %s: %s: %s" % (language, type(e).__name__, e))
            return None, None     # leave it to the server, ask again next time
        chosen = configured
        if configured and not self.has_voice(configured, language):
            others = [m for m in modules if m != configured and m not in FALLBACK_LAST]
            exact = [m for m in others if language in self.languages_or_empty(m)]
            rest = [m for m in others if m not in exact]
            last = [m for m in FALLBACK_LAST if m in modules and m != configured]
            for m in exact + rest + last:
                if self.has_voice(m, language):
                    chosen = m
                    break
            log("%s: %s has no voice for it, using %s" % (language, configured, chosen))
        else:
            log("%s: %s" % (language, configured))
        self.routes[language] = (chosen, configured)
        return chosen, configured

    def languages_or_empty(self, module):
        try:
            return self.module_languages(module)
        except Exception:
            return set()

    def call_probe(self, fn):
        probe = self.speechd.SSIPClient("speechd-reader", "probe", autospawn=True)
        try:
            return fn(probe)
        finally:
            probe.close()

    def speak(self, msg_id, parts, lang):
        ct = self.speechd.CallbackType
        text = ssml(parts)

        def callback(kind, index_mark=None):
            debug("speechd %s id=%s %s" % (kind, msg_id, index_mark or ""))
            if kind in (ct.END, ct.CANCEL):
                self.outstanding.discard(msg_id)
            if kind in (ct.BEGIN, ct.END, ct.CANCEL):
                send({"event": kind, "id": msg_id})
            elif kind == ct.INDEX_MARK and index_mark is not None \
                    and index_mark.isdigit() and int(index_mark) < len(parts):
                # not the server's own marks
                send({"event": "mark", "id": msg_id, "part": int(index_mark)})

        def do(client):
            language = speechd_language(lang)
            if language is not None:
                client.set_language(language)
                chosen, configured = self.route(language)
                # name the module every time: SET LANGUAGE changes it only
                # for languages with a LanguageDefaultModule, so after "en"
                # (LanguageDefaultModule) a "de" page would stay on the
                # module of "en"
                if chosen:
                    client.set_output_module(chosen)
                debug("speak id=%s lang=%s module=%s configured=%s outstanding=%s" % (
                    msg_id, language, chosen, configured, sorted(self.outstanding)))
            # before speak(): the end may come before speak() returns
            self.outstanding.add(msg_id)
            try:
                client.speak(text, callback=callback,
                             event_types=(ct.BEGIN, ct.END, ct.CANCEL, ct.INDEX_MARK))
            except Exception:
                self.outstanding.discard(msg_id)
                raise

        self.call(do)

    def set_rate(self, value):
        self.rate = value
        if value is None:
            # back to DefaultRate: a new connection starts with it.  What
            # is queued is cancelled and given back as lost, the extension
            # speaks it again at the new rate (the old connection's events
            # never come)
            with self.lock:
                lost = sorted(self.outstanding)
                if lost and self.client is not None:
                    try:
                        self.client.cancel()
                    except Exception:
                        pass
                self.drop()
            for msg_id in lost:
                send({"event": "lost", "id": msg_id})
        else:
            self.call(lambda c: c.set_rate(value))


def leave(signum, frame):
    raise SystemExit(0)


def main():
    # Firefox ends the host with SIGTERM when the extension is reloaded or
    # updated, or the browser quits: leave through the finally below, so the
    # sentences already queued in speechd are cancelled and not read on
    # with no one to stop them.
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, leave)
    speaker = Speaker()
    try:
        while True:
            try:
                msg = receive()
            except (ValueError, UnicodeDecodeError, json.JSONDecodeError) as e:
                send({"event": "error", "id": None, "message": str(e)})
                break   # the stream is out of step
            if msg is None:
                break
            if not isinstance(msg, dict):
                continue
            cmd = msg.get("cmd")
            msg_id = msg.get("id")
            try:
                if cmd == "speak":
                    parts = msg.get("parts", [msg.get("text")])
                    if not isinstance(msg_id, int) or not isinstance(parts, list) \
                            or not 0 < len(parts) <= MAX_PARTS \
                            or not all(isinstance(t, str) for t in parts):
                        raise ValueError("speak needs an integer id and a text or parts")
                    parts = [t.strip() for t in parts]
                    if sum(map(len, parts)) > MAX_TEXT:
                        raise ValueError("text too long")
                    if not any(parts):
                        send({"event": "end", "id": msg_id})
                        continue
                    speaker.speak(msg_id, parts, msg.get("lang"))
                elif cmd == "stop":
                    speaker.call(lambda c: c.cancel())
                elif cmd == "rate":
                    value = msg.get("value")
                    if value is not None and (not isinstance(value, int)
                                              or not -100 <= value <= 100):
                        raise ValueError("rate must be -100..100 or null")
                    speaker.set_rate(value)
                elif cmd == "hello":
                    send({"event": "hello", "version": VERSION, "rate": speaker.rate})
                else:
                    raise ValueError("unknown command %r" % (cmd,))
            except Exception as e:
                send({"event": "error", "id": msg_id if isinstance(msg_id, int) else None,
                      "message": str(e) or type(e).__name__})
    finally:
        # the browser closed the port: stop what this tab started
        try:
            if speaker.client is not None:
                speaker.client.cancel()
        except Exception:
            pass
        speaker.drop()


if __name__ == "__main__":
    main()
